<?xml version="1.0" encoding="UTF-8"?>
<!--
  Icons compiled directly into the gschem binary.

  The files are laid out exactly as the hicolor icon theme expects
  (<size>x<size>/<category>/<name>.png), so that the single runtime call
  gtk_icon_theme_add_resource_path("/org/geda/pcb/icons") makes them
  visible to ordinary gtk_image_new_from_icon_name() lookups.

  The names deliberately keep the historical "gtk-*" stock IDs used by
  gschem/src/actions.c, so the action table needs no renaming.

  To add an icon: drop the PNG in the matching directory and add a <file>
  line below.  There is no separate install step and no theme cache.

  The list below is generated from the contents of 16x16/actions/; keep
  it sorted so that it stays diffable.  Both families of names live
  here:

    gEDA action icons   insert-net, select, clone, ...  where gEDA has
                        its own artwork (most actions) that artwork wins
    gtk-* stock IDs     icons for actions gEDA never drew; those come
                        from Google Material Symbols (Apache-2.0), see
                        fetch-material-icons.sh and the README.
-->
<gresources>
  <gresource prefix="/org/geda/pcb/icons">
    <file>16x16/actions/attribute-attach.png</file>
    <file>16x16/actions/attribute-detach.png</file>
    <file>16x16/actions/attribute-show-both.png</file>
