    },
    {
      "id": "rgba-color",
      "pattern": "\\bgdk_color_parse\\b",
      "replacement": null,
      "reason": "Reverse parse argument order, use floating-point 0..1 channels and migrate all /65535 arithmetic and drawing consumers together.",
      "old_api": "gdk_color_parse / GdkColor",
      "target_api": "gdk_rgba_parse(&rgba, text) / GdkRGBA",
      "compiler_suggestion": "gdk_rgba_parse",
