      "id": "progress-dialog-alignment",
      "path": "src/hid/gtk/gtkhid-main.c",
      "pattern": "\\balignment = gtk_alignment_new \\(0\\., 0\\., 1\\., 1\\.\\);\\s*gtk_alignment_set_padding \\(GTK_ALIGNMENT \\(alignment\\), 8, 8, 8, 8\\);",
      "replacement": "alignment = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);\n  gtk_widget_set_margin_top (alignment, 8);\n  gtk_widget_set_margin_bottom (alignment, 8);\n  gtk_widget_set_margin_start (alignment, 8);\n  gtk_widget_set_margin_end (alignment, 8);",
      "old_api": "GtkAlignment",
      "target_api": "GtkBox and GtkWidget margins",
      "compiler_suggestion": null,
      "gschem_examples": [],
      "reason": "The sole alignment wrapper fills both axes and provides uniform eight-pixel padding; a single-child box and margins preserve that intent.",
      "conversion_state": "applied"
    },
    {
      "id": "popup-event-anchor",
      "path": "src/hid/gtk/gtkhid-main.c",
      "pattern": "\\bgtk_menu_popup\\s*\\(\\s*menu,\\s*NULL,\\s*NULL,\\s*NULL,\\s*NULL,\\s*0,\\s*gtk_get_current_event_time\\s*\\(\\s*\\)\\s*\\);",
      "replacement": "{\n        GdkEvent *event = gtk_get_current_event ();\n        GdkEventType type = event ? gdk_event_get_event_type (event) : GDK_NOTHING;\n        if (type == GDK_BUTTON_PRESS || type == GDK_BUTTON_RELEASE ||\n            type == GDK_MOTION_NOTIFY || type == GDK_SCROLL ||\n            type == GDK_TOUCH_BEGIN || type == GDK_TOUCH_END)\n          gtk_menu_popup_at_pointer (menu, event);\n        else\n          gtk_menu_popup_at_widget (menu, ghid_port.drawing_area,\n                                     GDK_GRAVITY_CENTER, GDK_GRAVITY_NORTH_WEST,\n                                     event);\n        if (event) gdk_event_free (event);\n      }",
      "old_api": "gtk_menu_popup",
      "target_api": "gtk_menu_popup_at_pointer / gtk_menu_popup_at_widget",
      "compiler_suggestion": "gtk_menu_popup_at_widget, gtk_menu_popup_at_pointer, gtk_menu_popup_at_rect",
      "gschem_examples": [
        "gschem/src/x_event.c:283",
        "gschem/src/gschem_messages_dockable.c:532"
      ],
      "reason": "Mouse events retain pointer placement; keyboard or programmatic invocations anchor to the drawing widget. The copied current event is freed.",
      "conversion_state": "applied"
    },
