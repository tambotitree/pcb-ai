{
  "schema_version": 1,
  "ruleset_version": 12,
  "policy": "One-time source migrations; no conversion in normal builds. Compiler hints and gschem examples inform reviewed rules.",
  "gschem_reference_root": "../ (companion geda-ai checkout; references for human review only)",
  "rules": [
    {
      "id": "typed-scroll-adjustments",
      "path": "src/hid/gtk/gui.h",
      "pattern": "\\bGtkObject\\s*\\*h_adjustment\\s*,\\s*\\*v_adjustment\\s*;",
      "replacement": "GtkAdjustment *h_adjustment, *v_adjustment;",
      "reason": "Both fields hold gtk_adjustment_new results, not AtkObject instances.",
      "old_api": "GtkObject adjustment fields",
      "target_api": "GtkAdjustment",
      "compiler_suggestion": null,
      "gschem_examples": [
        "gschem/include/gschem_page_view.h:48",
        "gschem/src/x_window.c:943"
      ],
      "conversion_state": "applied"
    },
    {
      "id": "dialog-object-signal-cast",
      "path": "src/hid/gtk/gui-utils.c",
      "pattern": "\\bGTK_OBJECT\\s*\\(\\s*dialog\\s*\\)",
      "replacement": "G_OBJECT (dialog)",
      "reason": "The response-signal connection accepts the existing dialog as a GObject.",
      "old_api": "GTK_OBJECT(dialog)",
      "target_api": "G_OBJECT(dialog)",
      "compiler_suggestion": null,
      "gschem_examples": [
        "gschem/src/gschem_toplevel.c:283"
      ],
      "conversion_state": "applied"
    },
    {
      "id": "horizontal-scrollbar",
      "path": "src/hid/gtk/gui-top-window.c",
      "pattern": "\\bgtk_hscrollbar_new\\s*\\(",
      "replacement": "gtk_scrollbar_new (GTK_ORIENTATION_HORIZONTAL, ",
      "reason": "GTK3 constructor takes an explicit orientation and the same adjustment.",
      "old_api": "gtk_hscrollbar_new",
      "target_api": "gtk_scrollbar_new(GTK_ORIENTATION_HORIZONTAL, adjustment)",
      "compiler_suggestion": null,
      "gschem_examples": [],
      "conversion_state": "applied"
    },
    {
      "id": "vertical-scrollbar",
      "path": "src/hid/gtk/gui-top-window.c",
