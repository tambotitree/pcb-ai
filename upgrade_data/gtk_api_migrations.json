        }
      ]
    },
    {
      "id": "draw-context-lifecycle",
      "pattern": "\\bgdk_cairo_create\\b",
      "replacement": null,
      "reason": "GTK3 cell renderers borrow cairo_t from GTK: change the virtual-method signature and never destroy that context. Direct-window drawing is a separate frame lifecycle.",
      "old_api": "gdk_cairo_create",
      "target_api": "Use GTK-provided cairo_t in cell renderer; frame API for direct window drawing",
      "compiler_suggestion": "gdk_window_begin_draw_frame + gdk_drawing_context_get_cairo_context",
      "gschem_examples": [
        "gschem/src/gschem_swatch_column_renderer.c:182",
        "gschem/src/x_stroke.c:120"
      ],
      "conversion_state": "needs_coordinated_rule",
      "applied_contexts": [
        {
          "path": "src/hid/gtk/ghid-cell-renderer-visibility.c",
          "converter": "tools/visibility_renderer_conversion.py",
          "date": "2026-10-20",
          "checks": "strict production object and standalone rendering/activation/lifetime fixture passed"
        }
      ]
    },
    {
      "id": "cell-renderer-cairo-signature",
      "path": "src/hid/gtk/ghid-cell-renderer-visibility.c",
      "pattern": "\\bghid_cell_renderer_visibility_render\\s*\\(\\s*GtkCellRenderer\\s*\\*cell\\s*,\\s*GdkWindow\\b",
      "replacement": null,
      "old_api": "GtkCellRenderer.render with GdkWindow and expose_area",
      "target_api": "render(cell, cairo_t *cr, widget, const background_area, const cell_area, flags)",
      "compiler_suggestion": null,
      "gschem_examples": [
        "gschem/src/gschem_swatch_column_renderer.c:182",
        "gschem/src/gschem_fill_swatch_cell_renderer.c:225"
      ],
      "conversion_state": "applied",
      "reason": "Preserve clipping and Cairo state with save/restore; GTK owns the context. Convert the callback signature and body as one rule.",
      "applied_contexts": [
        {
          "path": "src/hid/gtk/ghid-cell-renderer-visibility.c",
          "converter": "tools/visibility_renderer_conversion.py",
          "date": "2026-10-20",
          "checks": "strict production object and standalone rendering/activation/lifetime fixture passed"
        }
      ]
    },
    {
      "id": "queue-redraw-gtkhid-main.c",
      "path": "src/hid/gtk/gtkhid-main.c",
      "pattern": "\\bgdk_window_process_all_updates\\s*\\(\\s*\\)",
      "replacement": "gtk_widget_queue_draw (gport->drawing_area)",
      "old_api": "gdk_window_process_all_updates",
      "target_api": "gtk_widget_queue_draw",
      "compiler_suggestion": null,
      "gschem_examples": [
