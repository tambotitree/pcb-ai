      "target_api": "gtk_scrollbar_new(GTK_ORIENTATION_VERTICAL, adjustment)",
      "compiler_suggestion": null,
      "gschem_examples": [],
      "conversion_state": "applied"
    },
    {
      "id": "time-value-lifetime",
      "pattern": "\\b(?:GTimeVal|g_file_info_get_modification_time)\\b",
      "replacement": null,
      "reason": "Completed by timestamp_conversion.py using gschem timespec precedent; do not rerun or substitute GDateTime.",
      "old_api": "GTimeVal / g_file_info_get_modification_time",
      "target_api": "struct timespec + stat timestamp members",
      "compiler_suggestion": "GDateTime",
      "gschem_examples": [
        "gschem/src/gschem_change_notification.c:166",
        "gschem/src/x_highlevel.c:49"
      ],
      "conversion_state": "applied"
    },
    {
      "id": "style-context",
      "pattern": "\\bgtk_widget_get_style\\b",
      "replacement": null,
      "reason": "Use context queries, not GtkStyle fields; xthickness/ythickness need an explicit padding/border decision.",
      "old_api": "gtk_widget_get_style",
      "target_api": "gtk_widget_get_style_context + context query",
      "compiler_suggestion": "gtk_widget_get_style_context",
      "gschem_examples": [
        "gschem/src/gschem_fill_swatch_cell_renderer.c:241",
        "gschem/src/gschem_multiattrib_dockable.c:2679"
